{
  "name": "@ssh-tunnel/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ssh-tunnel": "./dist/cli.mjs"
  },
  "exports": {
    ".": "./src/cli.ts"
  },
