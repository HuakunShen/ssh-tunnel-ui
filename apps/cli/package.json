    "@ssh-tunnel/contract": "workspace:*",
    "@ssh-tunnel/host-node": "workspace:*",
    "@ssh-tunnel/service": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@ssh-tunnel/build-helper": "workspace:*"
  }
}
