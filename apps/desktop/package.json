{
  "name": "@ssh-tunnel/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tauri shell: spawns the daemon (or attaches to one) and opens the Web UI in a WebView. The UI and the API stay shared; this package only composes them.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "bun ./scripts/build.ts",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build:app": "tauri build",
    "test:e2e": "SSH_TUNNEL_WEBDRIVER=1 wdio run e2e/wdio.conf.ts"
  },
  "dependencies": {
    "@ssh-tunnel/client": "workspace:*",
    "@ssh-tunnel/contract": "workspace:*"
  },
  "devDependencies": {
    "@ssh-tunnel/build-helper": "workspace:*",
    "@tauri-apps/cli": "catalog:",
    "@wdio/cli": "catalog:",
    "@wdio/local-runner": "catalog:",
    "@wdio/mocha-framework": "catalog:",
    "@wdio/spec-reporter": "catalog:",
    "@wdio/tauri-service": "catalog:"
  }
}
